# Copy to .env.local and fill from base infra (Cognito, etc.)
# API base URL and WebSocket URL are set in src/config/environments/{development,staging,production}.ts
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=rdi-xxxx.auth.us-east-1.amazoncognito.com
VITE_REDIRECT_SIGN_IN=http://localhost:5173/auth/callback
VITE_REDIRECT_SIGN_OUT=http://localhost:5173
# Set to 'true' when Google is enabled in base infra
VITE_ENABLE_GOOGLE_AUTH=false
